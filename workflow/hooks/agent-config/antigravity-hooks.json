{
  "deny-dangerous": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|read_file|grep_search|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.goat-flow/hooks/antigravity-hook-bootstrap.cjs .goat-flow/hooks/deny-dangerous.mjs antigravity CLAUDE_PROJECT_DIR .agents/hooks.json .goat-flow/hooks/run-hook.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "deny-git-mutations": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.goat-flow/hooks/antigravity-hook-bootstrap.cjs .goat-flow/hooks/deny-git-mutations.mjs antigravity CLAUDE_PROJECT_DIR .agents/hooks.json .goat-flow/hooks/run-hook.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
